<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Exercise images load from the public exercise dataset; everything else works offline. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- The live workout notification, promoted to a Live Update on Android 16. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <!-- The end-of-rest alert has to come on time, locked and dozing: an exact alarm, like a kitchen timer. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission
    android:name="android.permission.SCHEDULE_EXACT_ALARM"
    android:maxSdkVersion="32" />
  <!-- Brings a workout's notification and rest alarm back after a reboot. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Updates from GitHub (update/AppUpdater.kt): Liora installs a newer release of itself when the user says
       so. Android asks once to allow it, then confirms each install, or not at all once Liora installed itself. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <!-- Health Connect, only once the user allows it there: finished workouts out, weight and body fat in.
       The same set as HealthConnectStore.permissions. -->
  <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
  <uses-permission android:name="android.permission.health.READ_WEIGHT" />
  <uses-permission android:name="android.permission.health.READ_BODY_FAT" />

  <!-- Health Connect is an app of its own up to Android 13. -->
  <queries>
    <package android:name="com.google.android.apps.healthdata" />
  </queries>

  <!-- System backup is off: backups go through Liora's own export and sync, which know how to merge. -->
  <application
    android:name=".LioraApplication"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Liora">

    <!-- Folding, unfolding and resizing only change the window size: Compose re-lays out in place
         instead of recreating the activity, so typed values, focus and running animations survive.
         Locale and night-mode changes still recreate, which the per-app language switch relies on.
         singleTop: tapping the workout notification opens the logger in the running activity. -->
    <activity
      android:name=".MainActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
      android:exported="true"
      android:launchMode="singleTop"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Health Connect shows Liora's privacy policy from its permission screens: up to Android 13
         through the rationale action, from Android 14 through the permission usage alias. -->
    <activity
      android:name=".health.PrivacyPolicyActivity"
      android:exported="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
      </intent-filter>
    </activity>
    <activity-alias
      android:name="ViewPermissionUsageActivity"
      android:exported="true"
      android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
      android:targetActivity=".health.PrivacyPolicyActivity">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
      </intent-filter>
    </activity-alias>

    <!-- Hands the camera app a file to write a progress photo into (core:ui PhotoSource); the
         authority must stay "<application id>.photos". No camera permission: the camera app takes it. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.photos"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/photo_paths" />
    </provider>

    <!-- The home-screen widget (widget/LioraWidget.kt). -->
    <receiver
      android:name=".widget.LioraWidgetReceiver"
      android:exported="true"
      android:label="@string/app_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/liora_widget_info" />
    </receiver>
    <!-- Android's answers about an update Liora handed it. -->
    <receiver
      android:name=".update.UpdateInstallReceiver"
      android:exported="false" />
    <receiver
      android:name=".workout.WorkoutActionReceiver"
      android:exported="false" />
    <receiver
      android:name=".workout.RestAlarmReceiver"
      android:exported="false" />
    <receiver
      android:name=".workout.WorkoutRestoreReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
