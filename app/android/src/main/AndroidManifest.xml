<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Exercise images load from the public exercise dataset; everything else works offline. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- System backup is off: backups go through Liora's own export and sync, which know how to merge. -->
  <application
    android:name=".LioraApplication"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Liora">

    <!-- Folding, unfolding and resizing only change the window size: Compose re-lays out in place
         instead of recreating the activity, so typed values, focus and running animations survive.
         Locale and night-mode changes still recreate, which the per-app language switch relies on. -->
    <activity
      android:name=".MainActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
      android:exported="true"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
