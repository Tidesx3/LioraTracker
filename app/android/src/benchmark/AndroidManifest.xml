<?xml version="1.0" encoding="utf-8"?>
<!-- Only in the builds that measure speed (benchmarkRelease, nonMinifiedRelease), never in what's released. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- The benchmarks start it to get the app ready to be measured (BenchmarkDataActivity). -->
        <activity
            android:name="app.liora.android.benchmark.BenchmarkDataActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true" />
    </application>
</manifest>
